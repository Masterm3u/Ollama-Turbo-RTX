<Window x:Class="OllamaTurboRTX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama-Turbo-RTX"
        Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Ollama-Turbo-RTX" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Hardware acceleration for NVIDIA RTX on Windows"
                       FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtGpu" Text="" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Current status -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Current environment (User scope)" FontWeight="SemiBold" FontSize="11" Foreground="#D4D4D8"/>
                <TextBlock x:Name="TxtStatus" Text="Loading..." FontSize="13" Foreground="#4ADE80" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Ctx picker for quick bench -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Bench num_ctx:" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbCtx4k" Content="4096" GroupName="Ctx" IsChecked="True"
                         Foreground="#E4E4E7" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbCtx16k" Content="16384" GroupName="Ctx"
                         Foreground="#E4E4E7" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" VerticalAlignment="Top">
            <Button Content="[1] Turbo Context  —  Flash Attention + Q8 KV"
                    Click="BtnTurboContext_Click" Height="42" Margin="0,0,0,8"
                    Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

            <Button Content="[2] Turbo Pure Speed  —  Flash Attention only"
                    Click="BtnTurboSpeed_Click" Height="42" Margin="0,0,0,8"
                    Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" BorderThickness="0"/>

            <Button Content="[3] Restore Stock  —  FA off, KV FP16"
                    Click="BtnReset_Click" Height="42" Margin="0,0,0,8"
                    Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"/>

            <Button x:Name="BtnBench" Content="[4] Quick Bench  —  tokens/s (local API)"
                    Click="BtnBench_Click" Height="42" Margin="0,0,0,8"
                    Background="#14532D" Foreground="#BBF7D0" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="TxtFeedback" Text="Ready. No admin required — writes User environment variables."
                       FontSize="11" Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#52525B" TextAlignment="Center"
                       Text="github.com/Masterm3u/Ollama-Turbo-RTX"/>
        </StackPanel>
    </Grid>
</Window>
