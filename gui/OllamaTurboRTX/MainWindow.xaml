<Window x:Class="OllamaTurboRTX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama-Turbo-RTX"
        Icon="Assets/app.ico"
        Height="860" Width="1000"
        MinHeight="720" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0C0C0E"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
            <Border DockPanel.Dock="Left" Width="96" Height="96" CornerRadius="12" Margin="0,0,16,0"
                    Background="#FFFFFF" BorderBrush="#27272A" BorderThickness="1" ClipToBounds="True" Padding="4">
                <Image Source="Assets/app.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Ollama Turbo" FontSize="30" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock x:Name="TxtSubtitle" Text="Acceleration GPU NVIDIA RTX pour Ollama"
                           FontSize="14" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtGpu" FontSize="13" Foreground="#D4D4D8" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#18181B" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                BorderBrush="#27272A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LblState" Text="ETAT ACTUEL" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                    <TextBlock x:Name="TxtStatus" Text="…" FontSize="18" FontWeight="SemiBold"
                               Foreground="#4ADE80" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="BtnRefresh" Content="Actualiser" Click="BtnRefresh_Click" Style="{StaticResource TileSmall}"
                            Width="150" HorizontalAlignment="Left" Margin="0,10,0,0" Background="#27272A"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock x:Name="LblLang" Text="LANGUE" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                    <UniformGrid Columns="4" Width="300">
                        <Button x:Name="BtnLangFr" Content="FR" Tag="fr" Click="BtnLang_Click" Style="{StaticResource TileSmallOn}"/>
                        <Button x:Name="BtnLangEn" Content="EN" Tag="en" Click="BtnLang_Click" Style="{StaticResource TileSmall}"/>
                        <Button x:Name="BtnLangEs" Content="ES" Tag="es" Click="BtnLang_Click" Style="{StaticResource TileSmall}"/>
                        <Button x:Name="BtnLangDe" Content="DE" Tag="de" Click="BtnLang_Click" Style="{StaticResource TileSmall}"/>
                    </UniformGrid>
                    <TextBlock x:Name="LblCtx" Text="CONTEXTE BENCH" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,12,0,6"/>
                    <UniformGrid Columns="2" Width="300">
                        <Button x:Name="BtnCtx4k" Content="4 096" Tag="4096" Click="BtnCtx_Click" Style="{StaticResource TileSmallOn}"/>
                        <Button x:Name="BtnCtx16k" Content="16 384" Tag="16384" Click="BtnCtx_Click" Style="{StaticResource TileSmall}"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LblOpt" Text="OPTIMISATIONS" FontSize="12" FontWeight="Bold" Foreground="#71717A" Margin="6,0,0,4"/>
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource Tile}" Background="#0284C7" Height="110" Tag="install-context" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T1" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="T1b" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.95"/>
                            <TextBlock x:Name="T1c" FontSize="12" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#0E7490" Height="110" Tag="install-speed" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T2" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="T2b" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.95"/>
                            <TextBlock x:Name="T2c" FontSize="12" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#3F3F46" Height="110" Tag="restore" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T3" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="T3b" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.95"/>
                            <TextBlock x:Name="T3c" FontSize="12" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock x:Name="LblBench" Text="BENCHMARK" FontSize="12" FontWeight="Bold" Foreground="#71717A" Margin="6,14,0,4"/>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource Tile}" Background="#166534" Height="100" Tag="bench" Click="BtnBench_Click">
                        <StackPanel>
                            <TextBlock x:Name="T4" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="T4b" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#14532D" Height="100" Tag="bench-multi" Click="BtnBench_Click">
                        <StackPanel>
                            <TextBlock x:Name="TM" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TMb" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock x:Name="LblTools" Text="OUTILS" FontSize="12" FontWeight="Bold" Foreground="#71717A" Margin="6,14,0,4"/>
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource Tile}" Background="#1E3A5F" Height="96" Tag="health" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T6" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="T6b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#1E3A5F" Height="96" Tag="smart" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T7" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="T7b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#1E3A5F" Height="96" Tag="vram" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TA" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TAb" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#312E81" Height="96" Tag="workflow-coding" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T8c" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="T8cb" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#312E81" Height="96" Tag="workflow-chat" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T8h" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="T8hb" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#44403C" Height="96" Tag="undo" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="T9" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="T9b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#1E3A5F" Height="96" Tag="gpu-check" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TG" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TGb" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#854D0E" Height="96" Tag="watchdog-install" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TW1" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TW1b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#854D0E" Height="96" Tag="watchdog" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TW2" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TW2b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#78350F" Height="96" Tag="watchdog-remove" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TW3" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TW3b" FontSize="12" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#422006" Height="96" Tag="support" Click="BtnAction_Click">
                        <StackPanel>
                            <TextBlock x:Name="TS" FontSize="15" FontWeight="Bold" Foreground="#FDE68A"/>
                            <TextBlock x:Name="TSb" FontSize="12" Margin="0,6,0,0" Foreground="#FDE68A" Opacity="0.9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Background="#18181B" Height="96" Click="BtnQuit_Click">
                        <StackPanel>
                            <TextBlock x:Name="TQ" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TQb" FontSize="12" Margin="0,6,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#09090B" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                BorderBrush="#27272A" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="LblJournal" DockPanel.Dock="Top" Text="JOURNAL" FontSize="11" FontWeight="Bold"
                           Foreground="#71717A" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent"
                         Foreground="#A1A1AA" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtFeedback" Margin="0,10,0,0" FontSize="13"
                   Foreground="#A1A1AA" TextWrapping="Wrap" TextAlignment="Center"/>
    </Grid>
</Window>
