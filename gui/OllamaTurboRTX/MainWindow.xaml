<Window x:Class="OllamaTurboRTX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama-Turbo-RTX"
        Icon="Assets/app.ico"
        Height="720" Width="640"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Ollama-Turbo-RTX" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Lang" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbLang" Width="70" Height="26"
                              Background="#27272A" Foreground="#E4E4E7" BorderThickness="0">
                        <ComboBoxItem Content="en" IsSelected="True"/>
                        <ComboBoxItem Content="fr"/>
                        <ComboBoxItem Content="es"/>
                        <ComboBoxItem Content="de"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="Meme options que le script PowerShell — Machine env + redemarrage Ollama"
                       FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtGpu" Text="" FontSize="11" Foreground="#71717A" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtScript" Text="" FontSize="10" Foreground="#52525B" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Click="BtnRefresh_Click"
                        Height="28" Padding="10,0" Margin="8,0,0,0"
                        Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"/>
                <StackPanel>
                    <TextBlock Text="Current environment (Machine scope — Admin)" FontWeight="SemiBold" FontSize="11" Foreground="#D4D4D8"/>
                    <TextBlock x:Name="TxtStatus" Text="Loading..." FontSize="13" Foreground="#4ADE80" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Optimisations" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                <Button Content="[1] Turbo Context (FA + Q8 KV) — longs contextes / ~-50% VRAM"
                        Tag="install-context" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"
                        Background="#0284C7" Foreground="White" FontWeight="Bold"/>
                <Button Content="[2] Turbo Pure Speed (FA only) — debit tokens max"
                        Tag="install-speed" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[3] Rollback Stock — FA off, KV FP16"
                        Tag="restore" Click="BtnAction_Click" Style="{StaticResource ActionBtn}" Background="#3F3F46"/>

                <TextBlock Text="Benchmark" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,12,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="num_ctx" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbCtx4k" Content="4096" GroupName="Ctx" IsChecked="True" Foreground="#E4E4E7" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbCtx16k" Content="16384" GroupName="Ctx" Foreground="#E4E4E7"/>
                </StackPanel>
                <Button Content="[4] Full Bench — Stock vs FA vs FA+Q8 (fenetre Admin)"
                        Tag="bench" Click="BtnBench_Click" Style="{StaticResource ActionBtn}"
                        Background="#14532D" Foreground="#BBF7D0"/>
                <Button Content="[M] Multi-model Bench — 7B / 14B / 32B (long)"
                        Tag="bench-multi" Click="BtnBench_Click" Style="{StaticResource ActionBtn}"
                        Background="#14532D" Foreground="#BBF7D0"/>

                <TextBlock Text="Diagnostic et presets" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,12,0,6"/>
                <Button Content="[6] Health Check — Ollama / driver / API"
                        Tag="health" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[7] Smart GPU Preset — auto selon VRAM"
                        Tag="smart" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[8] Workflow: Coding / Cursor (Context)"
                        Tag="workflow-coding" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[8] Workflow: Fast Chat (Speed)"
                        Tag="workflow-chat" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[9] Undo — restaurer le dernier snapshot historique"
                        Tag="undo" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[A] VRAM estimate — contexte FP16 vs Q8"
                        Tag="vram" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[GPU] GPU check — architecture / alerte &lt; RTX 2000"
                        Tag="gpu-check" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>

                <TextBlock Text="Watchdog et support" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,12,0,6"/>
                <Button Content="[W] Watchdog — installer (logon)"
                        Tag="watchdog-install" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[W] Watchdog — verifier / reparer maintenant"
                        Tag="watchdog" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[W] Watchdog — retirer"
                        Tag="watchdog-remove" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"/>
                <Button Content="[S] Support — GitHub star + Buy me a coffee"
                        Tag="support" Click="BtnAction_Click" Style="{StaticResource ActionBtn}"
                        Background="#422006" Foreground="#FDE68A"/>
                <Button Content="[Q] Quitter" Click="BtnQuit_Click" Style="{StaticResource ActionBtn}"
                        Background="#18181B"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#09090B" CornerRadius="8" Padding="8" BorderBrush="#27272A" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sortie (script PowerShell)" FontSize="10" Foreground="#71717A" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" Foreground="#A1A1AA" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtFeedback" Margin="0,8,0,0" FontSize="11"
                   Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Pret. Les actions Machine ouvrent une invite UAC (comme le .ps1 Admin)."/>
    </Grid>
</Window>
