<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\OllamaTurboRTX\Assets\app.ico</ApplicationIcon>
    <AssemblyName>OllamaTurboRTX-Setup</AssemblyName>
    <RootNamespace>OllamaTurboRTX.Setup</RootNamespace>
    <Version>1.2.5</Version>
    <Authors>Masterm3u</Authors>
    <Product>Ollama-Turbo-RTX Setup</Product>
    <Description>Installer bootstrapper for Ollama-Turbo-RTX</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\OllamaTurboRTX-Setup.msi" Condition="Exists('Payload\OllamaTurboRTX-Setup.msi')" />
  </ItemGroup>
</Project>
